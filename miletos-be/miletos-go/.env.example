# Service identity
MILETOS_RUNTIME_SERVICE_NAME=miletos-go
MILETOS_RUNTIME_ENVIRONMENT=local

# HTTP server
MILETOS_RUNTIME_HTTP_HOST=0.0.0.0
MILETOS_RUNTIME_HTTP_PORT=8081
MILETOS_RUNTIME_GRPC_HOST=0.0.0.0
MILETOS_RUNTIME_GRPC_PORT=9091
MILETOS_RUNTIME_PUBLIC_TRIGGER_BASE_URL=https://runtime.example.invalid

# Logging
MILETOS_RUNTIME_LOG_LEVEL=info

# Internal Java-to-Go authentication
MILETOS_RUNTIME_INTERNAL_SERVICE_TOKEN=replace-with-32-byte-token-value

# PostgreSQL
MILETOS_RUNTIME_POSTGRES_HOST=127.0.0.1
MILETOS_RUNTIME_POSTGRES_PORT=55432
MILETOS_RUNTIME_POSTGRES_DATABASE=miletos
MILETOS_RUNTIME_POSTGRES_USER=miletos
MILETOS_RUNTIME_POSTGRES_PASSWORD=replace-with-local-password
MILETOS_RUNTIME_POSTGRES_SSL_MODE=disable

# Kafka-backed asynchronous execution
MILETOS_RUNTIME_KAFKA_ENABLED=false
MILETOS_RUNTIME_KAFKA_BROKERS=127.0.0.1:9092
MILETOS_RUNTIME_KAFKA_CLIENT_ID=miletos-go-engine-v1
MILETOS_RUNTIME_KAFKA_COMMAND_TOPIC=miletos.workflow.node.commands.v1
MILETOS_RUNTIME_KAFKA_DEAD_LETTER_TOPIC=miletos.workflow.node.dead-letter.v1
MILETOS_RUNTIME_KAFKA_CONSUMER_GROUP=miletos-go-engine-v1

# Retry policy
MILETOS_RUNTIME_RETRY_MAX_ATTEMPTS=3
MILETOS_RUNTIME_RETRY_DELAY=250ms
MILETOS_RUNTIME_NODE_CONCURRENCY=2
MILETOS_RUNTIME_RECONCILIATION_ENABLED=true
MILETOS_RUNTIME_RECONCILIATION_INTERVAL=30s
MILETOS_RUNTIME_RECONCILIATION_QUEUED_STALE=2m
MILETOS_RUNTIME_RECONCILIATION_RUNNING_STALE=10m
MILETOS_RUNTIME_RECONCILIATION_RETRY_PENDING_STALE=2m

# Cron-trigger scheduler (requires Kafka-backed asynchronous execution)
MILETOS_RUNTIME_CRON_ENABLED=false
MILETOS_RUNTIME_CRON_POLL_INTERVAL=15s
MILETOS_RUNTIME_CRON_BATCH_SIZE=50

# Destination output plugins (CSV files are written under this directory)
MILETOS_RUNTIME_OUTPUT_DIRECTORY=output
