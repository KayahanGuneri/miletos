# Service identity
MILETOS_RUNTIME_SERVICE_NAME=miletos-go
MILETOS_RUNTIME_ENVIRONMENT=local

# HTTP server
MILETOS_RUNTIME_HTTP_HOST=0.0.0.0
MILETOS_RUNTIME_HTTP_PORT=8081
MILETOS_RUNTIME_HTTP_READ_HEADER_TIMEOUT=5s
MILETOS_RUNTIME_HTTP_READ_TIMEOUT=15s
MILETOS_RUNTIME_HTTP_WRITE_TIMEOUT=15s
MILETOS_RUNTIME_HTTP_IDLE_TIMEOUT=60s

# Process lifecycle
MILETOS_RUNTIME_SHUTDOWN_TIMEOUT=10s

# Logging
MILETOS_RUNTIME_LOG_LEVEL=info
# Runtime API
MILETOS_RUNTIME_INTERNAL_SERVICE_TOKEN=replace-with-32-byte-token-value
MILETOS_RUNTIME_HTTP_HANDLER_TIMEOUT=30s
MILETOS_RUNTIME_SWAGGER_ENABLED=true
